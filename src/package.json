{
  "$schema": "../node_modules/ng-packagr/package.schema.json",
  "name": "@ngxs-extensions/decorators",
  "version": "1.0.0",
  "license": "MIT",
  "sideEffects": true,
  "main": "./fesm2015/ngxs-extensions-decorators.js",
  "module": "./fesm2015/ngxs-extensions-decorators.js",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./fesm2015/ngxs-extensions-decorators.js"
    }
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0 <19.0.0",
    "@ngxs/store": ">=18.0.0 <19.0.0",
    "rxjs": ">=7.8.0 <8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefan-schubert/ngxs-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/stefan-schubert/ngxs-extensions/issues"
  },
  "homepage": "https://github.com/stefan-schubert/ngxs-extensions#readme",
  "ngPackage": {
    "lib": {
      "flatModuleFile": "ngxs-extensions-decorators",
      "entryFile": "index.ts",
      "umdModuleIds": {
        "@ngxs/store": "ngxs-store"
      }
    },
    "dest": "../dist/decorators"
  }
}
