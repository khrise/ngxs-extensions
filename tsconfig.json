{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "decorators": ["src"],
      "decorators/*": ["src/*"]
    },
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2022", "dom"],
    "moduleResolution": "node",
    "strict": true,
    "allowJs": false,
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true,
    "noImplicitReturns": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  }
}
