{
  "name": "@ngxs-extensions/decorators",
  "version": "1.1.0",
  "description": "Extensions for @ngxs/store.",
  "scripts": {
    "lint": "echo \"No lint task configured\"",
    "test": "ng test --coverage",
    "build": "ng build",
    "verify:exports": "node -e \"const fs=require('fs'); const path=require('path'); const pkg=require('./package.json'); const e=pkg.exports?.['.']?.default; if(!e){throw new Error('Missing exports[\".\"].default');} const target=path.resolve(process.cwd(), e.replace(/^\\.\\//,'')); if(!fs.existsSync(target)){throw new Error('Missing export target: '+target);} console.log('Verified export target:', e);\"",
    "ci": "npm run build && npm run verify:exports && npm run test"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefan-schubert/ngxs-extensions.git"
  },
  "keywords": [
    "ngxs",
    "store",
    "decorator"
  ],
  "author": "Stefan Schubert",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stefan-schubert/ngxs-extensions/issues"
  },
  "homepage": "https://github.com/stefan-schubert/ngxs-extensions#readme",
  "engines": {
    "node": ">=18 <23"
  },
  "devDependencies": {
    "@angular-builders/jest": "^19.0.0",
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@ngxs/store": "^19.0.0",
    "@types/istanbul-lib-report": "3.0.0",
    "@types/jest": "^29.5.14",
    "@types/prettier": "2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "core-js": "^3.39.0",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "ng-packagr": "^19.2.0",
    "rollup": "^2.22.0",
    "rollup-plugin-typescript2": "^0.30.0",
