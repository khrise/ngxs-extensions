    "ts-jest": "^29.2.5",
    "tslib": "^2.0.0",
    "typescript": "~5.8.2",
    "zone.js": "~0.15.0"
  },
  "sideEffects": true,
  "main": "dist/decorators/fesm2022/ngxs-extensions-decorators.mjs",
  "module": "dist/decorators/fesm2022/ngxs-extensions-decorators.mjs",
  "types": "dist/decorators/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/decorators/index.d.ts",
